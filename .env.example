DATABASE_URL="postgresql://postgres@localhost:5432/bizos?schema=public"
AUTH_SECRET="dev-only-change-me-0123456789abcdef0123456789abcdef"
APP_URL="http://localhost:3000"
CRON_SECRET="dev-cron-secret"
TELEPHONY_WEBHOOK_SECRET="dev-telephony-secret"
# ANTHROPIC_API_KEY="sk-ant-..."   # enables AI Copilot, AI briefing, AI lead insights
AI_MODEL="claude-opus-5-5"

# ── Phase 2 ──
# 32-byte hex key for AES-256-GCM field encryption (generate: openssl rand -hex 32). Falls back to a key derived from AUTH_SECRET in dev.
# ENCRYPTION_KEY=""
# Email (Resend) — without it, emails are logged as "simulated"
# RESEND_API_KEY=""
# EMAIL_FROM="BizOS <noreply@yourdomain.com>"
# WhatsApp Business Cloud API
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
# SMS gateway webhook (POST {to, text})
# SMS_WEBHOOK_URL=""
# Set to "off" on serverless / multi-instance and call GET /api/cron/tick every minute instead
# INTERNAL_SCHEDULER="on"
