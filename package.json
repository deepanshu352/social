{
  "name": "bizos",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered multi-tenant Business Operating System (CRM + Calling + Sales + Invoicing + AI Copilot)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/smoke.js && node tests/e2e/flows.js && node tests/e2e/flows2.js && node tests/e2e/flows3.js",
    "db:rls": "psql \"$DATABASE_URL\" -f prisma/rls.sql",
    "db:upgrade": "tsx prisma/upgrade-v2.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.17",
    "lucide-react": "1.74.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
